{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "References",
  "type": "object",
  "additionalProperties": false,
  "required": ["references"],

  "properties": {
    "references": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/reference"
      }
    }
  },

  "definitions": {
    "reference": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "language",
        "year",
        "title",
        "authors"
      ],

      "properties": {
        "language": {
          "type": "string",
          "description": "Language of the publication. BCP 47 language tag, e.g. en, ja, en-US.",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },

        "year": {
          "type": "integer",
          "description": "Publication year",
          "minimum": 0
        },

        "month": {
          "type": "integer",
          "description": "Publication month",
          "minimum": 1,
          "maximum": 12
        },

        "title": {
          "type": "string",
          "description": "Title of the work",
          "minLength": 1
        },

        "venue": {
          "type": "string",
          "description": "Journal, conference, proceedings, or other publication venue"
        },

        "publisher": {
          "type": "string",
          "description": "Publisher"
        },

        "collection": {
          "type": "string",
          "description": "Series or collection containing the work"
        },

        "location": {
          "type": "string",
          "description": "Publication or conference location"
        },

        "pages": {
          "type": "string",
          "description": "Page or page range, e.g. 12-22"
        },

        "doi": {
          "type": "string",
          "description": "Digital Object Identifier",
          "pattern": "^10\\.[0-9]{4,9}/\\S+$"
        },

        "url": {
          "type": "string",
          "description": "URL of the work",
          "format": "uri"
        },

        "isbn": {
          "type": "string",
          "description": "ISBN"
        },

        "authors": {
          "type": "array",
          "description": "Authors in display order",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/person"
          }
        }
      }
    },

    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family"],

      "properties": {
        "family": {
          "type": "string",
          "description": "Family name"
        },

        "given": {
          "type": "string",
          "description": "Given name"
        },

        "prefix": {
          "type": "string",
          "description": "Name prefix, e.g. von"
        },

        "suffix": {
          "type": "string",
          "description": "Name suffix, e.g. Jr."
        }
      }
    }
  }
}